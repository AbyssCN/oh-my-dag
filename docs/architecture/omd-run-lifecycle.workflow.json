    {
      "dot": "cyan",
      "title": "验收阶梯(不跳级)",
      "items": [
        "① 机械 oracle: tsc / bun test / expect_exit / 产物闸 / 写集对账",
        "② 跨模型 verifier: oracle 判不了语义时才问, 必须换家族",
        "③ 人: 前两层都判不了 → escalate, 不许 defer 不许擅断"
      ]
    },
    {
      "dot": "rose",
      "title": "两类失败通道",
      "items": [
        "fail-closed: 白名单 / 写域 / 产物闸 / 点火闸 —— 拒了不许原样重试",
        "fail-open: 消耗预告 / 回执 / Thinker 批评步 —— 挂了不挡主流程, 必留证据行"
      ]
    }
