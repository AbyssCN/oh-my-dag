{
  "name": "oh-my-dag",
  "version": "0.3.0",
  "description": "oh-my-dag — a DAG execution engine exposed as an MCP server. Typed nodes → concurrent fan-out → cross-model verify → escalate on failure; pathfinder mode (persistent decision maps for multi-session work), an agent-template registry, a memory layer, and a bundle of /omd-* client skills that install themselves into your MCP client. Any OpenAI-compatible backend plugs in, plus OAuth providers via the pi-ai catalog. No terminal UI: your MCP client is the front end.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbyssCN/oh-my-dag.git"
  },
  "bugs": {
    "url": "https://github.com/AbyssCN/oh-my-dag/issues"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "harness",
    "oh-my",
    "dag",
    "workflow",
    "orchestration",
    "agent",
    "coding-agent",
    "memory",
    "llm",
    "multi-agent",
    "model-agnostic",
    "mcp",
    "bun"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "oh-my-dag": "src/harness/cli.ts",
    "omd": "src/harness/cli.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "scripts",
    "!scripts/**/*.test.ts",
    "client-skills",
    "templates",
    "substrate",
    "tsconfig.json",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "omd": "bun run src/harness/cli.ts",
    "init": "bun run src/harness/cli.ts init",
    "mcp": "bun run src/harness/cli.ts mcp",
    "dag-research": "bun run scripts/dag-research.ts",
    "dag-council": "bun run scripts/dag-council.ts",
    "dag-fanout": "bun run scripts/dag-fanout.ts",
    "dag-review": "bun run scripts/dag-review.ts",
    "dag-debug": "bun run scripts/dag-debug.ts",
    "dag-build": "bun run scripts/dag-build.ts",
    "omd-path": "bun run scripts/omd-path.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dag-deepen": "bun run scripts/dag-deepen.ts",
    "dag-slim": "bun run scripts/dag-slim.ts",
    "omd-debt": "bun run scripts/omd-debt.ts",
    "plan-doc-check": "bun run scripts/plan-doc-check.ts",
    "omd-render": "bun run scripts/omd-render.ts",
    "omd-deliver": "bun run scripts/omd-deliver.ts",
    "bench": "bun run scripts/omd-bench.ts",
    "bench:validate": "bun run scripts/omd-bench.ts validate",
    "bench:extract": "bun run scripts/omd-bench.ts extract --limit 400 --max 6",
    "bench:selftest": "bun run scripts/omd-bench.ts selftest"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.0",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@oh-my-pi/hashline": "^15.7.6",
    "@sinclair/typebox": "^0.34.49",
    "js-yaml": "^4.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "typebox": "^1.3.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "playwright-core": "^1.62.0",
    "typescript": "^5.7.0",
    "yaml": "^2.9.0"
  }
}
